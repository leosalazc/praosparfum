# Desarrollo: Node 24 (o >=22.13), npm ci, cp .env.example .env, npm run dev.
# Completa las claves SOLO en .env local o en las variables privadas de Vercel.
# No publiques .env ni escribas credenciales en GitHub o en el navegador.

# Opcional: reemplaza temporalmente la contraseña preparada en el servidor.
# El acceso funciona sin esta variable; ADMIN_SESSION_SECRET ya no se utiliza.
# Para preparar otra contraseña: configura ADMIN_PASSWORD de forma privada,
# ejecuta npm run admin:password -- --replace y despliega la huella actualizada.
ADMIN_PASSWORD=

# Desarrollo local: SQLite en data/praos.sqlite si DATABASE_URL está vacío.
# Vercel/producción: PostgreSQL persistente (Neon, por ejemplo). Usa la URL del proveedor.
# Se verifica TLS para todo servidor PostgreSQL remoto; no se permite TLS sin verificación.
DATABASE_URL=
# Si tu proveedor usa una CA privada: certificado PEM de confianza (opcional).
# DATABASE_SSL_CA=
# SQLITE_FILE=/ruta/persistente/praos.sqlite
# ALLOW_SQLITE_PRODUCTION=true  # solo servidor Node con disco persistente; nunca Vercel

APP_URL=http://localhost:3000
# Cambia APP_URL por el dominio HTTPS definitivo al desplegar en Vercel.
# TRUST_PROXY=1  # solo si existe un único proxy inverso confiable; nunca exponer Node directo

# Botón Webpay del proyecto: confirmación manual del importe recibido en /admin.
WEBPAY_ENV=link
WEBPAY_FORM_ID=114823
# Reserva de unidades disponibles al iniciar el pedido; libera al cancelar o vencer.
RESERVATION_TTL_MINUTES=30

# Correo opcional. Gmail necesita contraseña de aplicación; nunca contraseña de cuenta.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=ventas@tudominio.cl
# NOTIFY_EMAIL=correo-del-comercio@example.com

# Alternativa futura opcional: Webpay Plus requiere contrato y credenciales del comercio.
# WEBPAY_ENV=production
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENV=integration  # exclusivamente pagos simulados, no cobra dinero
